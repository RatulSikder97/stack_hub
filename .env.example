# Active provider: openai | gemini | anthropic | novita
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Novita (OpenAI-compatible API)
NOVITA_API_KEY=
NOVITA_MODEL=meta-llama/llama-3.3-70b-instruct
NOVITA_BASE_URL=https://api.novita.ai/v3/openai

# Pipeline tuning
# Gemini 2.5 Flash/Pro consume tokens for "thinking" before output —
# keep these generous so JSON responses don't get truncated.
LLM_MAX_TOKENS_DRAFT=8000
LLM_MAX_TOKENS_DETECTOR=4000
LLM_MAX_TOKENS_VOICE=4000
LLM_TEMPERATURE=0.7

# ---- Auth (web panel) ----
# Required to log in. Plain text is fine for localhost; for any deployment
# beyond your own machine, use *_PASSWORD_HASH (bcrypt) and rotate
# AUTH_SECRET to a long random string.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
USER_USERNAME=user
USER_PASSWORD=user

# Sign session cookies. CHANGE BEFORE EXPOSING ON A NETWORK.
AUTH_SECRET=change-me-to-a-long-random-string

# 30 days default
AUTH_SESSION_DAYS=30

# Set to "true" to disable auth entirely (skip the login page).
# AUTH_DISABLED=false

# ---- Real-time meeting bot (optional) ----
# Sign up at https://www.recall.ai/ — free trial covers a few meetings.
# Cost is roughly $0.50/meeting hour after that.
RECALL_API_KEY=
# RECALL_BASE_URL=https://ap-northeast-1.recall.ai/api/v1

# Transcription provider Recall uses for the bot. Default "meeting_captions"
# is free but uses Zoom/Meet's native captions — English-only on Zoom.
# For Bengali / multilingual support, set provider to "deepgram_streaming"
# and add your Deepgram API key in the Recall dashboard at
# Settings -> Integrations -> Deepgram. Deepgram async ~$0.005/audio-min.
# RECALL_TRANSCRIPTION_PROVIDER=deepgram_streaming
# RECALL_TRANSCRIPTION_LANGUAGE=bn
# RECALL_TRANSCRIPTION_MODEL=nova-2-general
