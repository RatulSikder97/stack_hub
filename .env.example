# Active provider: openai | gemini | anthropic | novita
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Novita (OpenAI-compatible API)
NOVITA_API_KEY=
NOVITA_MODEL=meta-llama/llama-3.3-70b-instruct
NOVITA_BASE_URL=https://api.novita.ai/v3/openai

# Pipeline tuning
LLM_MAX_TOKENS_DRAFT=4000
LLM_MAX_TOKENS_DETECTOR=1200
LLM_MAX_TOKENS_VOICE=2000
LLM_TEMPERATURE=0.7
