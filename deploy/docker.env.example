# =============================================================================
# Compose env template. Copy to repo-root .env and fill in real values:
#     cp deploy/docker.env.example .env
# Then `chmod 600 .env`.
#
# DO NOT commit .env. (.gitignore already excludes it.)
# =============================================================================

# --- Public hostname for HTTPS / Caddy ---
DOMAIN=studio.example.com
ACME_EMAIL=you@example.com

# --- Active LLM provider ---
LLM_PROVIDER=gemini

# Google Gemini (free tier covers light personal use)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Novita (OpenAI-compatible)
NOVITA_API_KEY=
NOVITA_MODEL=meta-llama/llama-3.3-70b-instruct
NOVITA_BASE_URL=https://api.novita.ai/v3/openai

# --- Pipeline tuning ---
LLM_MAX_TOKENS_DRAFT=8000
LLM_MAX_TOKENS_DETECTOR=8000
LLM_MAX_TOKENS_VOICE=4000
LLM_TEMPERATURE=0.7

# --- Auth (web panel) ---
# Generate strong secrets and write them here BEFORE first deploy.
#   ADMIN_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=' | head -c 20)
#   USER_PASSWORD=$(openssl  rand -base64 18 | tr -d '/+=' | head -c 20)
#   AUTH_SECRET=$(openssl    rand -hex 32)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
USER_USERNAME=user
USER_PASSWORD=
AUTH_SECRET=
AUTH_SESSION_DAYS=30

# --- Real-time meeting bot (optional) ---
RECALL_API_KEY=
